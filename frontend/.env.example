# Optional. Local dev only: where Next.js proxies /api/* (defaults to http://127.0.0.1:5001).
# API_DEV_URL=http://127.0.0.1:5001

# Optional. Supabase project for user accounts (Supabase dashboard: Project Settings, API Keys).
# Leave these empty and the app runs exactly as before, with the account UI hidden.
# Both values are public (they ship to the browser); row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key is used if no publishable key is set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
